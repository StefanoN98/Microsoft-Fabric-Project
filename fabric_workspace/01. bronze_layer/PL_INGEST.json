                        "typeProperties": {
                            "notebookId": "9585088c-65d7-4fe6-8b8f-61a07f7f5f98",
                            "workspaceId": "47f4b971-7b6b-4af9-8001-77745ea917c0"
                        }
                    },
                    {
                        "name": "Filter_Sql_Server",
                        "type": "Filter",
                        "dependsOn": [
                            {
                                "activity": "LK_Config",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
