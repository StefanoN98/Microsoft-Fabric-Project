                        ],
                        "typeProperties": {
                            "items": {
                                "value": "@activity('LK_Config').output.value",
                                "type": "Expression"
                            },
                            "condition": {
                                "value": "@and(\n    equals(item().Enabled, '1'),\n    equals(item().SourceType, 'ADLS')\n)",
                                "type": "Expression"
                            }
                        }
                    },
                    {
                        "name": "ForEach1",
                        "type": "ForEach",
                        "dependsOn": [
                            {
                                "activity": "Filter_ADLS",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "typeProperties": {
                            "items": {
                                "value": "@activity('Filter_ADLS').output.value",
                                "type": "Expression"
                            },
                            "isSequential": true,
                            "activities": [
                                {
                                    "name": "If Condition1",
                                    "type": "IfCondition",
                                    "dependsOn": [],
                                    "typeProperties": {
                                        "expression": {
                                            "value": "@equals(item().CopyMode, 'COPY')",
                                            "type": "Expression"
                                        },
                                        "ifFalseActivities": [
                                            {
                                                "name": "Shortcut x products",
                                                "type": "TridentNotebook",
                                                "dependsOn": [],
