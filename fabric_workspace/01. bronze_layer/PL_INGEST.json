                                        },
                                        "sink": {
                                            "type": "BinarySink",
                                            "storeSettings": {
                                                "type": "AzureBlobStorageWriteSettings"
                                            },
                                            "datasetSettings": {
                                                "annotations": [],
                                                "linkedService": {
                                                    "name": "LH_Bronze",
                                                    "properties": {
                                                        "annotations": [],
                                                        "type": "Lakehouse",
                                                        "typeProperties": {
                                                            "workspaceId": "47f4b971-7b6b-4af9-8001-77745ea917c0",
                                                            "artifactId": "[parameters('LH_Bronze')]",
                                                            "rootFolder": "Files"
                                                        }
                                                    }
                                                },
                                                "type": "Binary",
                                                "typeProperties": {
                                                    "location": {
                                                        "type": "LakehouseLocation",
                                                        "fileName": {
                                                            "value": "@item().ObjectName",
                                                            "type": "Expression"
                                                        },
                                                        "folderPath": {
                                                            "value": "@item().DestinationFolder",
                                                            "type": "Expression"
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        "enableStaging": false
                                    }
                                }
                            ]
                        }
