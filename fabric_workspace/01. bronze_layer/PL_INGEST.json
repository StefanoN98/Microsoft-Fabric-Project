                        "typeProperties": {
                            "items": {
                                "value": "@activity('LK_Config').output.value",
                                "type": "Expression"
                            },
                            "condition": {
                                "value": "@and(\n       and(\n           equals(item().Enabled, '1'),\n           equals(item().SourceType, 'GITHUB')\n       ),\n       not(equals(item().ObjectName, 'web_logs.json'))\n   )",
                                "type": "Expression"
                            }
