                                            "formatSettings": {
                                                "type": "BinaryReadSettings"
                                            },
                                            "datasetSettings": {
                                                "annotations": [],
                                                "type": "Binary",
                                                "typeProperties": {
                                                    "location": {
                                                        "type": "HttpServerLocation",
                                                        "relativeUrl": {
                                                            "value": "@concat(item().SourceFolder, '/', item().ObjectName)",
                                                            "type": "Expression"
                                                        }
                                                    }
                                                },
                                                "externalReferences": {
                                                    "connection": "[parameters('github_globalretail alice.ferrua199 (2)')]"
