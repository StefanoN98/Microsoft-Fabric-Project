                        ],
                        "typeProperties": {
                            "items": {
                                "value": "@activity('LK_Config').output.value",
                                "type": "Expression"
                            },
                            "condition": {
                                "value": "@and(\n    equals(item().Enabled, '1'),\n    equals(item().SourceType, 'SQL Server')\n)",
                                "type": "Expression"
                            }
                        }
                    },
                    {
                        "name": "ForEach3",
                        "type": "ForEach",
                        "dependsOn": [
                            {
                                "activity": "Filter_Sql_Server",
                                "dependencyConditions": [
                                    "Succeeded"
